#!/usr/bin/env bash

CACHE_FILE="$HOME/.cache/waybar-weather.json"
FETCH_SCRIPT="$HOME/.config/custom_scripts/weather-fetch"

if [ -f "$CACHE_FILE" ]; then
    cat "$CACHE_FILE"
else
    # No cache yet (first-ever run) - show a placeholder immediately,
    # and kick off a background fetch so the cache exists for next time.
    echo '{"text": "…", "tooltip": "Fetching weather...", "class": "weather-loading"}'
    nohup "$FETCH_SCRIPT" >/dev/null 2>&1 &
    disown
fi
