#!/usr/bin/env bash

LAT="37.7782"
LON="-81.1882"
UNIT="fahrenheit"
CACHE_FILE="$HOME/.cache/waybar-weather.json"
WAYBAR_SIGNAL=8   # must match the "signal" value in config.jsonc

response=$(curl -s --connect-timeout 5 --max-time 10 \
    "https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current_weather=true&temperature_unit=${UNIT}")

temp=$(echo "$response" | jq -r '.current_weather.temperature')
code=$(echo "$response" | jq -r '.current_weather.weathercode')

case "$code" in
    0) icon="" ;;
    1|2) icon="" ;;
    3) icon="" ;;
    45|48) icon="" ;;
    51|53|55|56|57) icon="" ;;
    61|63|65|66|67) icon="" ;;
    71|73|75|77) icon="" ;;
    80|81|82) icon="" ;;
    95|96|99) icon="" ;;
    *) icon="" ;;
esac

unit_symbol=$([ "$UNIT" = "fahrenheit" ] && echo "°F" || echo "°C")

if [ -z "$temp" ] || [ "$temp" = "null" ]; then
    # Fetch failed - leave the existing cache alone rather than
    # overwriting good data with an error, unless there's no cache yet.
    if [ ! -f "$CACHE_FILE" ]; then
        echo '{"text": "?", "tooltip": "Weather unavailable", "class": "weather-error"}' > "$CACHE_FILE"
    fi
else
    printf '{"text": "%s %.0f%s", "tooltip": "Current temperature: %.0f%s", "class": "weather"}\n' \
        "$icon" "$temp" "$unit_symbol" "$temp" "$unit_symbol" > "$CACHE_FILE"
fi

pkill -RTMIN+"$WAYBAR_SIGNAL" waybar 2>/dev/null || true
