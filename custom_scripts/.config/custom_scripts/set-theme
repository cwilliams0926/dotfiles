#!/usr/bin/env bash
#
# Usage: set-theme.sh <theme-name>

set -euo pipefail

theme="${1:-}"
if [ -z "$theme" ]; then
    echo "Usage: set-theme.sh <theme-name>" >&2
    exit 1
fi

# ---- paths - adjust these if your dotfiles live somewhere else ----
CENTRAL_STATE="$HOME/.config/current-theme"
HYPR_COLORS="$HOME/.config/hypr/colors/colors.lua"
KITTY_COLORS="$HOME/.config/kitty/colors/colors.conf"
ROFI_COLORS="$HOME/.config/rofi/colors/colors.rasi"
WLOGOUT_COLORS="$HOME/.config/wlogout/colors/colors.css"
WAYBAR_COLORS="$HOME/.config/waybar/colors/colors.css"
HYPRLOCK_COLORS="$HOME/.config/hypr/colors/colors-lock.conf"
TMUX_COLORS_PRE="$HOME/.config/tmux/colors/pre-plugin.conf"
TMUX_COLORS_POST="$HOME/.config/tmux/colors/post-plugin.conf"
SWAYNC_COLORS="$HOME/.config/swaync/colors/colors.css"
HYPRLOCK_WALLPAPER="$HOME/.config/hypr/colors/wallpaper.conf"
WALLPAPER_ROOT="$HOME/.config/wallpapers"

# GTK doesn't have a colors/custom/ palette mechanism like the others -
# it needs a whole installed theme NAME per palette. Map your theme
# names to actual installed GTK theme names here. Anything not listed
# (or not actually installed) falls back to Graphite-Dark.
declare -A GTK_THEME_MAP=(
    ["gruvbox-material"]="Gruvbox-Material-Dark"
    ["catppuccin"]="catppuccin-mocha-blue-standard+default"
    ["everforest"]="Everforest-Dark"
    ["gruvbox"]="Gruvbox-Dark"
    ["rosepine"]="rose-pine-gtk"
    ["tokyonight"]="Tokyonight-Dark"
    ["e-ink"]="Adwaita"
)
GTK_ICON_THEME="Papirus-Dark"
GTK_CURSOR_THEME="Bibata-Modern-Classic"

# 1. Write the central state file - this is what wallpaper-picker.sh
#    and Neovim's config/theme.lua both read to know the active theme.
echo "$theme" > "$CENTRAL_STATE"

# 2. Hyprland - colors.lua just requires the matching palette module.
echo "return require(\"colors.custom.$theme\")" > "$HYPR_COLORS"

# 3. Kitty - colors.conf includes the matching palette file.
#    Path is relative to colors.conf itself (custom/<theme>.conf).
echo "include custom/$theme.conf" > "$KITTY_COLORS"

# 4. Rofi - colors.rasi imports the palette, then the shared widget rules.
#    Order matters: variables must be defined before common.rasi uses them.
{
    echo "@import \"custom/$theme.rasi\""
    echo "@import \"common.rasi\""
} > "$ROFI_COLORS"

# 5. wlogout - same @import pattern as rofi, GTK CSS flavor.
echo "@import url(\"custom/$theme.css\");" > "$WLOGOUT_COLORS"

# 6. Waybar - same GTK CSS @import pattern.
echo "@import url(\"custom/$theme.css\");" > "$WAYBAR_COLORS"

# 6b. Hyprlock - hyprlang source directive, same idea, different syntax.
#     Expects a matching custom/<theme>-lock.conf file to exist.
echo "source = custom/$theme-lock.conf" > "$HYPRLOCK_COLORS"

# 6c. Tmux - two source-file pointers: one runs before the catppuccin
#     plugin loads (sets flavor), one runs after (overrides @thm_* colors
#     for non-catppuccin themes). Both target files must exist for every
#     theme, even if empty - source-file errors on a missing file.
echo "source-file $HOME/.config/tmux/colors/custom/$theme-pre.conf" > "$TMUX_COLORS_PRE"
echo "source-file $HOME/.config/tmux/colors/custom/$theme-post.conf" > "$TMUX_COLORS_POST"

# 6e. Swaync - same GTK CSS @import pattern as wlogout/waybar.
echo "@import url(\"custom/$theme.css\");" > "$SWAYNC_COLORS"

# 6d. GTK - no palette file, just an installed theme NAME. Look up the
#     mapped name for this theme, falling back to a neutral default if
#     this theme has no mapping (or the mapped theme isn't installed).
gtk_theme="${GTK_THEME_MAP[$theme]:-Graphite-Dark}"

# e-ink is the one light-background theme in the set - flip the
# dark-preference flag accordingly so GTK apps don't look inverted.
if [ "$theme" = "e-ink" ]; then
    gtk_prefer_dark=0
else
    gtk_prefer_dark=1
fi

gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
gsettings set org.gnome.desktop.interface icon-theme "$GTK_ICON_THEME"
gsettings set org.gnome.desktop.interface cursor-theme "$GTK_CURSOR_THEME"
gsettings set org.gnome.desktop.interface color-scheme \
    "$([ "$gtk_prefer_dark" = 1 ] && echo prefer-dark || echo prefer-light)"

# Mirror into settings.ini too, since not every GTK app (especially
# outside a full GNOME session, and most GTK4 apps) reads gsettings.
for gtk_ini in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    mkdir -p "$(dirname "$gtk_ini")"
    cat > "$gtk_ini" <<EOF
[Settings]
gtk-theme-name=$gtk_theme
gtk-icon-theme-name=$GTK_ICON_THEME
gtk-cursor-theme-name=$GTK_CURSOR_THEME
gtk-application-prefer-dark-theme=$gtk_prefer_dark
EOF
done

# 7. Reload what needs reloading.
hyprctl reload

pkill -SIGUSR1 kitty 2>/dev/null || true

pkill -SIGUSR1 nvim

pkill -SIGUSR2 waybar 2>/dev/null || true

if tmux info &>/dev/null; then
    tmux source-file "$HOME/.config/tmux/tmux.conf"
fi

if pgrep -x swaync >/dev/null; then
    swaync-client --reload-css
fi

# 8. Pick a default wallpaper for this theme and apply it.
theme_wall_dir="$WALLPAPER_ROOT/$theme"
if [ -d "$theme_wall_dir" ]; then
    default_wall=$(find "$theme_wall_dir" -maxdepth 1 -type f \
        \( -iname "default.jpg" -o -iname "default.jpeg" -o -iname "default.png" -o -iname "default.gif" \) \
        | head -n 1)

    if [ -z "$default_wall" ]; then
        default_wall=$(find "$theme_wall_dir" -maxdepth 1 -type f \
            \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.gif" \) \
            | shuf -n 1)
    fi

    if [ -n "$default_wall" ]; then
        awww img "$default_wall" --transition-type wipe --transition-step 90
        echo "$default_wall" > "$HOME/.cache/current-wallpaper"
        echo "\$wallpaper = $default_wall" > "$HYPRLOCK_WALLPAPER"
    else
        notify-send "Theme" "No wallpapers found in $theme_wall_dir"
    fi
else
    notify-send "Theme" "No wallpaper folder for '$theme' at $theme_wall_dir"
fi

notify-send "Theme" "Switched to: $theme"
