/* ==========================================================================
   File: gruvbox-common.rasi
   Desc: Shared rules between all gruvbox themes
   Author: bardisty <b@bah.im>
   Source: https://github.com/bardisty/gruvbox-rofi
   Modified: Mon Feb 12 2018 06:06:47 PST -0800
   ========================================================================== */


window {
    location: center;
    anchor: center;
    fullscreen: false;
    width: 600px;
    x-offset: 0px;
    y-offset: 0px;
    margin: 0px;
    background-color: rgba(34, 34, 34, 0.8);
    border-radius:    30px;
    padding: 0px;
}

mainbox {
    spacing: 10px;
    padding: 20px;
    background-color: transparent;
}

message {
    border: 0px;
    padding: 10px;
    margin: 0px;
    border-color: @gruvbox-dark-blue;
    text-color: @normal-foreground;
}

textbox {
    highlight:  @highlight;
    text-color: inherit;
}

listview {
    spacing:      5px;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    border-radius: 0px;
    scrollbar:    false;
    background-color: transparent;
    lines: 6;
    columns: 2;
    cycle: true;
    dynamic: true;
    layout: vertical;
    cursor: "default";
    fixed-height: true;
    fixed-columns: true;
    reverse: false;
}

element {
    border:  0px;
    padding: 10px;
    background-color: transparent;
    text-color: @normal-foreground;
    cursor: pointer;
}

element selected {
    background-color: @gruvbox-dark-blue;
    text-color: @gruvbox-dark-bg0;
    border-radius: 20px;
}

scrollbar {
    border:       0;
    handle-color: @scrollbar-handle;
    handle-width: 0;
    padding:      0;
}

mode-switcher {
    enabled: false;
    border-color: @separatorcolor;
}

inputbar {
    background-color: transparent; 
    spacing: 0;
    padding: 0 0 12px;
    border: 0px;
    border-radius: 0px;
    children:   [ prompt, textbox-prompt-sep, entry, case-indicator ];
}

case-indicator,
entry,
prompt,
button {
    spacing:    0;
    text-color: @normal-foreground;
}

case-indicator {
    background-color: transparent;
}

entry {
    background-color: transparent;
    border-color: @gruvbox-dark-blue;
    border: 2px;
    border-radius: 20px;
    padding: 8px;
    spacing: 0px;
    cursor: text;
}

prompt {
    background-color: transparent;
    padding: 10px;
    text-color: @gruvbox-dark-blue;
}

button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

textbox-prompt-sep {
    expand: false;
    padding: 10px 0px;
    border-radiu: 0px;
    background-color: transparent;
    text-color: @gruvbox-dark-blue;
}

element-text, element-icon {
    background-color: transparent;
    text-color: @gruvbox-dark-fg1;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

element-text selected {
    text-color: @gruvbox-dark-bg0;
}
