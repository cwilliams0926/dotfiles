{
  "layer": "top",
  "height": 29,
  "spacing": 4,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "modules-center": [
    "custom/arch-logo",
    "clock",
    "hyprland/workspaces",
    "network",
    "pulseaudio",
    "battery"
  ],
 "custom/arch-logo": {
    "format": "<span>  </span>",
    "separate-outputs": true,
    "icon": false,
    "tooltip": false
 },
 "hyprland/workspaces": {
    "disable-scroll": true,
    "active-only": false,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    },
    "format-icons": {
      "1": "<span>1</span>",
      "2": "<span>2</span>",
      "3": "<span>3</span>",
      "4": "<span>4</span>",
      "5": "<span>5</span>",
      "6": "<span>6</span>",
      "7": "<span>7</span>",
      "8": "<span>8</span>"
    }
  },
  "pulseaudio": {
    "scroll-step": 1,
    "format": "<span color='#d8a657' >  </span>",
    "format-muted": "<span color='#ea6962' >  </span>",
    "format-bluetooth": "<span color='#d8a657' > 󰂰 </span>",
    "format-bluetooth-muted": "<span color='#ea6962' > 󰂲 </span>",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false,
    "max-volume": 130
  },
  "battery#bat2": {
    "bat": "BAT2"
  },
  "battery": {
    "interval": 1,
    "states": {
      "good": 99,
      "warning": 30,
      "critical": 20
    },
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format": "<span color='#a9b665' > {icon} </span>",
    "format-critical": "<span color='#cc241d' > {icon} </span>",
    "format-warning": "<span color='#e78a4e' > {icon} </span>",
    "format-full": "<span color='#a9b665' > {icon} </span>",
    "format-charging": "<span color='#a9b665' > 󰂅 </span>",
    "format-charging-warning": "<span color='#e78a4e' > 󰢝 </span>",
    "format-charging-critical": "<span color='#cc241d' > 󰢜 </span>",
    "format-plugged": "<span color='#a9b665' > 󰂅 </span>",
    "format-alt": "<span color='#a9b665' > 󱧥 </span>{time}",
    "tooltip": false
  },
  "network": {
    "interval": 2,
    "format": "<span color='#d3869b'> 󱘖 </span>",
    "format-wifi": "<span color='#d3869b'> {icon} </span>",
    "format-ethernet": "<span color='#d3869b'> 󰈀 </span>",
    "format-icons": [
      "󰤫",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip": false,
    "states": {
      "normal": 25
    }
  },
  "clock": {
    "timezone": "America/New_York",
    "format": "{:%H:%M}",
    "tooltip": false,
    "interval": 1
  }
}

