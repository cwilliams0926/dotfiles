{
  "layer": "top",
  "height": 32,
  "spacing": 4,
  "margin-top": 12,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": ["custom/arch-logo", "pulseaudio","custom/weather"],
  "modules-center": ["clock", "hyprland/workspaces"],
  "modules-right": ["network", "battery", "custom/notification"],
  "custom/arch-logo": {
    "format": "",
    "separate-outputs": true,
    "icon": false,
    "tooltip": false
  },
  "custom/weather": {
    "exec": "~/.config/custom_scripts/weather",
    "return-type": "json",
    "signal": 8,
    "tooltip": true
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
        "notification": "󱅫",
        "none": "󰂜",
        "dnd-notification": "󰂠",
        "dnd-none": "󰪓",
        "inhibited-notification": "󰂛",
        "inhibited-none": "󰪑",
        "dnd-inhibited-notification": "󰂛",
        "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "active-only": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    },
    "format-icons": {
      "1": "󰛸",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "6",
      "7": "7",
      "8": "8"
    }
  },
  "pulseaudio": {
    "scroll-step": 1,
    "format": "  {volume}%",
    "format-muted": "  {volume}%",
    "format-bluetooth": "󰂰  {volume}%",
    "format-bluetooth-muted": "󰂲  {volume}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": true,
    "tooltip-format": "{volume}%",
    "max-volume": 130
  },
  "battery#bat2": {
    "bat": "BAT2"
  },
  "battery": {
    "interval": 1,
    "states": {
      "good": 99,
      "warning": 30,
      "critical": 20
    },
    "format-icons": ["", "", "", "", ""], 
    "format": "{icon}  {capacity}%",
    "format-critical": "{icon}  {capacity}%",
    "format-warning": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "tooltip": true,
    "tooltip-format": "{capacity}%"
  },
  "network": {
    "interval": 2,
    "format": "󱘖 Not Connected",
    "format-wifi": "{icon}  {essid}",
    "format-ethernet": "󰈀",
    "format-icons": ["󰤫", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip": true,
    "tooltip-format": "{essid}",
    "states": {
      "normal": 25
    }
  },
  "clock": {
    "timezone": "America/New_York",
    "format": "{:%I:%M %p}",
    "tooltip": false,
    "interval": 1
  }
}
