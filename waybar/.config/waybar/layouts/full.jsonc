{
  "layer": "top",
  "height": 32,
  "spacing": 4,
  "margin-top": 12,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": ["custom/arch-logo", "custom/weather"],
  "modules-center": ["clock", "hyprland/workspaces"],
  "modules-right": ["pulseaudio", "network", "battery"],
  "custom/arch-logo": {
    "format": "",
    "separate-outputs": true,
    "icon": false,
    "tooltip": false
  },
  "custom/weather": {
    "exec": "~/.config/custom_scripts/weather",
    "return-type": "json",
    "interval": 900,
    "tooltip": true
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "active-only": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    },
    "format-icons": {
      "1": "<span>󰛸</span>",
      "2": "<span></span>",
      "3": "<span></span>",
      "4": "<span></span>",
      "5": "<span></span>",
      "6": "<span>6</span>",
      "7": "<span>7</span>",
      "8": "<span>8</span>"
    }
  },
  "pulseaudio": {
    "scroll-step": 1,
    "format": "   {volume}%",
    "format-muted": "   {volume}%",
    "format-bluetooth": "󰂰   {volume}%",
    "format-bluetooth-muted": "󰂲   {volume}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": true,
    "tooltip-format": "{volume}%",
    "max-volume": 130
  },
  "battery#bat2": {
    "bat": "BAT2"
  },
  "battery": {
    "interval": 1,
    "states": {
      "good": 99,
      "warning": 30,
      "critical": 20
    },
    "format-icons": ["", "", "", "", ""], 
    "format": "{icon}   {capacity}%",
    "format-critical": "{icon}   {capacity}%",
    "format-warning": "{icon}   {capacity}%",
    "format-full": "{icon}   {capacity}%",
    "tooltip": true,
    "tooltip-format": "{capacity}%"
  },
  "network": {
    "interval": 2,
    "format": "󱘖",
    "format-wifi": "{icon}   {essid}",
    "format-ethernet": "󰈀",
    "format-icons": ["󰤫", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip": true,
    "tooltip-format": "{essid}",
    "states": {
      "normal": 25
    }
  },
  "clock": {
    "timezone": "America/New_York",
    "format": "{:%I:%M %p}",
    "tooltip": false,
    "interval": 1
  }
}
